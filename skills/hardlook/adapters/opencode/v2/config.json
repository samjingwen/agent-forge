{
  "$schema": "https://opencode.ai/config.json",
  "snapshots": false,
  "formatter": false,
  "agents": {
    "hardlook-peer": {
      "description": "Independent evidence-first code reviewer; no changes or delegation",
      "mode": "primary",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env*", "effect": "deny" },
        { "action": "read", "resource": "*auth.json", "effect": "deny" },
        { "action": "read", "resource": "*auth.yaml", "effect": "deny" },
        { "action": "read", "resource": "*auth.toml", "effect": "deny" },
        { "action": "read", "resource": "*credentials*", "effect": "deny" },
        { "action": "read", "resource": "*.netrc", "effect": "deny" },
        { "action": "read", "resource": "*.npmrc", "effect": "deny" },
        { "action": "read", "resource": "*/.aws/*", "effect": "deny" },
        { "action": "read", "resource": "*tokens.json", "effect": "deny" },
        { "action": "read", "resource": "*oauth_creds.json", "effect": "deny" },
        { "action": "read", "resource": "*.pem", "effect": "deny" },
        { "action": "read", "resource": "*.key", "effect": "deny" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
